# Copy to .env.local (gitignored). See phases/shared/CONTRACTS.md §10.
NEXT_PUBLIC_API_URL=http://localhost:8000
# on = serve every API call from MSW mocks backed by packages/contracts fixtures
NEXT_PUBLIC_API_MOCKING=off
# Clerk: leave empty to run without auth in development, or run `npx clerk@latest init --accountless`
# for temporary dev keys, or paste keys from dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
