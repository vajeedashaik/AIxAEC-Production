# Root values consumed by compose.yaml (copy to .env, gitignored). Per-service details: services/*/.env.example.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# Supabase runs on the host (`cd services/api; supabase start`); containers reach it via host.docker.internal.
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres
SUPABASE_URL_DOCKER=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (dashboard.clerk.com, or `npx clerk@latest init --accountless` in apps/web)
CLERK_ISSUER=https://your-app.clerk.accounts.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OmniRoute on the host (:20128)
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_API_KEY=
LLM_MODEL=

# Web build args
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MOCKING=off
