# Build from the repo root: docker build -f services/vision/Dockerfile.lambda .
# Debian base plus the Lambda runtime client, because Amazon Linux 2023 has no Tesseract package.
# OCR_PROVIDER picks tesseract (default stack) or textract (needs a paid AWS plan).
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv LAMBDA_TASK_ROOT=/var/task
WORKDIR /src
COPY packages/contracts packages/contracts
COPY services/vision/pyproject.toml services/vision/uv.lock services/vision/
RUN cd services/vision && uv sync --frozen --no-dev && uv pip install --python /opt/venv/bin/python awslambdaric
COPY services/vision/app ${LAMBDA_TASK_ROOT}/app
# PYTHONPATH skips .pth files, so the editable contracts package needs its own entry.
ENV PYTHONPATH=/opt/venv/lib/python3.12/site-packages:/src/packages/contracts/src:${LAMBDA_TASK_ROOT}
WORKDIR ${LAMBDA_TASK_ROOT}
ENTRYPOINT ["/opt/venv/bin/python", "-m", "awslambdaric"]
CMD ["app.lambda_handler.handler"]
