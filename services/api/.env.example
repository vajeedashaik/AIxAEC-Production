# Copy to .env (gitignored). Values per phases/shared/CONTRACTS.md §10.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Worker connection. With a Supabase pooler use the session-mode (5432) or direct URL here,
# and the transaction-mode (6543) URL for DATABASE_URL. Defaults to DATABASE_URL.
WORKER_DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
# Base for signed URLs when the browser reaches Supabase at another address than the API does
SUPABASE_PUBLIC_URL=
# from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL defaults to ${CLERK_ISSUER}/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000","http://localhost:3001"]
CLERK_SECRET_KEY=
VISION_URL=http://127.0.0.1:8001
GEOMETRY_URL=http://127.0.0.1:8002
LANGUAGE_URL=http://127.0.0.1:8003
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
MAX_UPLOAD_BYTES=26214400
MAX_AUDIO_BYTES=10485760
MAX_IMAGE_PIXELS=64000000
MAX_PROJECTS_PER_USER=200
MAX_FLOORPLANS_PER_PROJECT=100
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_STALE_SECONDS=600
WORKER_POLL_SECONDS=2
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=90
