{
  "$defs": {
    "Job": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Message"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "floorplan_id": {
          "format": "uuid",
          "title": "Floorplan Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageReport"
          },
          "title": "Stages",
          "type": "array"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "status": {
          "enum": [
            "PENDING",
            "PROCESSING",
            "COMPLETED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "floorplan_id",
        "status",
        "attempts",
        "stages",
        "error_message",
        "created_at",
        "started_at",
        "finished_at"
      ],
      "title": "Job",
      "type": "object"
    },
    "StageReport": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Detail",
          "type": "object"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "name": {
          "enum": [
            "preprocess",
            "wall_detection",
            "ocr",
            "object_detection",
            "room_detection",
            "calibration",
            "semantic_assembly",
            "artifacts"
          ],
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "degraded",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "duration_ms",
        "error",
        "detail"
      ],
      "title": "StageReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_type": {
      "title": "Content Type",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_model_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Model Version"
    },
    "download_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Download Url"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "latest_job": {
      "anyOf": [
        {
          "$ref": "#/$defs/Job"
        },
        {
          "type": "null"
        }
      ]
    },
    "original_filename": {
      "title": "Original Filename",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "size_bytes": {
      "title": "Size Bytes",
      "type": "integer"
    },
    "status": {
      "enum": [
        "PENDING",
        "PROCESSING",
        "COMPLETED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "version",
    "original_filename",
    "content_type",
    "size_bytes",
    "status",
    "current_model_version",
    "download_url",
    "latest_job",
    "warnings",
    "created_at"
  ],
  "title": "FloorPlan",
  "type": "object"
}
